# ============================================================================

# ----------------------------------------------------------------------------
# RECOMMENDED — private deployment access (inactive when both are blank)
# ----------------------------------------------------------------------------
# YUDUN_BASIC_AUTH_USER=yudun
# YUDUN_BASIC_AUTH_PASSWORD=generate_a_long_random_password

# ----------------------------------------------------------------------------
# DOMESTIC GEO CHANNELS — configure only the providers you enable in the UI
# ----------------------------------------------------------------------------
# Baidu Qianfan AI Search. A run is marked grounded_search_api only when the
# upstream response contains source URLs; otherwise it is marked model_api.
# BAIDU_QIANFAN_API_KEY=your_qianfan_api_key
# BAIDU_AI_SEARCH_BASE_URL=https://qianfan.baidubce.com/v2/ai_search
# BAIDU_AI_SEARCH_MODEL=deepseek-v4-pro
# BAIDU_AI_SEARCH_SOURCE=baidu_search_v2
# BAIDU_AI_SEARCH_DEEP_SEARCH=true
# BAIDU_AI_SEARCH_TOP_K=10
# One Qianfan key can also drive the Qianfan-hosted DeepSeek, Qwen, ERNIE, GLM
# and Kimi providers when their provider-specific API keys are blank. Native
# keys still take priority when configured.
# QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2

# Tencent Hunyuan TokenHub. Search enhancement is opt-in because supported
# fields vary by endpoint; evidence is never upgraded without returned URLs.
# HUNYUAN_API_KEY=your_hunyuan_api_key
# HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
# HUNYUAN_MODEL=hy3-preview
# HUNYUAN_ENABLE_SEARCH=false

# DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# DOUBAO_API_KEY=your_volcengine_ark_api_key
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_MODEL=doubao-seed-2-0-lite-260215

# QWEN_API_KEY=your_dashscope_api_key
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3.7-plus

# KIMI_API_KEY=your_moonshot_api_key
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=kimi-k2.5

# Read-only evidence handoff to GEOFlow. This endpoint never publishes or
# mutates content: GET /api/geoflow/export?limit=100
# GEOFLOW_EXPORT_SECRET=generate_a_separate_long_random_secret
# Bearer secret used only by the server-side daily runner and GEO admin AJAX.
# YUDUN_OPS_SECRET=generate_a_separate_long_random_secret
# YUDUN_GEO_EVIDENCE_LEDGER_PATH=/data/yudun-geo-evidence.jsonl
# YUDUN_GEO_OPERATIONS_LEDGER_PATH=/data/yudun-geo-operations.jsonl
# Explicitly opt providers into daily paid/API collection; blank means technical
# audits still run but no external model request is made.
# YUDUN_GEO_PROVIDERS=baidu_ai_search,deepseek_api,qwen_api,ernie_api,glm_api,kimi_api
# YUDUN_GEO_MAX_PROVIDER_RUNS=36
# YUDUN_GEO_PROVIDER_CONCURRENCY=6
# geo-aeo-tracker — environment template
# Copy this file to `.env` and fill in your own values:  cp .env.example .env
# Only the REQUIRED block is needed to run the tracker. Everything else is
# optional and the app degrades gracefully when it is missing.
# ============================================================================

# ----------------------------------------------------------------------------
# OPTIONAL — Bright Data consumer-product snapshots
# ----------------------------------------------------------------------------
# Your Bright Data API key (Account settings -> API keys).
BRIGHT_DATA_KEY=your_bright_data_api_key

# AI Scraper dataset IDs, one per engine. Get them from the Bright Data
# Scrapers Library: https://brightdata.com/cp/scrapers
# Each engine is independent — set only the ones you want to track. A missing
# dataset just skips that engine; it does not break the others.
BRIGHT_DATA_DATASET_CHATGPT=gd_xxx
BRIGHT_DATA_DATASET_PERPLEXITY=gd_xxx
BRIGHT_DATA_DATASET_COPILOT=gd_xxx
BRIGHT_DATA_DATASET_GEMINI=gd_xxx
BRIGHT_DATA_DATASET_GOOGLE_AI=gd_xxx

# OPTIONAL. Bright Data does not always list a public Grok scraper. If the
# Scrapers Library has no Grok dataset for your account, leave this blank and
# deselect Grok in the dashboard — the other engines run fine without it.
# BRIGHT_DATA_DATASET_GROK=gd_xxx

# ----------------------------------------------------------------------------
# OPTIONAL — Bright Data zones for the SRO pipeline (SERP + Web Unlocker)
# Create these once in the Bright Data dashboard and paste the zone NAMES here.
# ----------------------------------------------------------------------------
# SERP API zone. Type: "SERP API". Default settings are fine.
# https://brightdata.com/products/serp-api
BRIGHT_DATA_SERP_ZONE=your_serp_zone

# Web Unlocker zone. Type: "Web Unlocker". Default settings are fine
# (JS rendering on, auto CAPTCHA). Used to scrape cited/target pages.
# https://brightdata.com/products/web-unlocker
BRIGHT_DATA_UNLOCKER_ZONE=your_web_unlocker_zone

# ----------------------------------------------------------------------------
# OPTIONAL — OpenRouter (LLM inference for analysis, SRO, site-context)
# ----------------------------------------------------------------------------
OPENROUTER_KEY=your_openrouter_api_key

# OPTIONAL. Override the OpenRouter model. Default: google/gemini-3.5-flash
# OPENROUTER_MODEL=google/gemini-3.5-flash

# ----------------------------------------------------------------------------
# REQUIRED for SRO Analysis — Google Gemini API key
# This is SEPARATE from OpenRouter and does a different job. It powers the
# Gemini "grounding" stage, which uses Google Search grounding to see which
# pages Gemini actually cites in real time. OpenRouter cannot do that, so the
# key is needed even though OpenRouter is also configured. Without it, the rest
# of the SRO pipeline still runs and just skips the grounding stage.
# ----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# ----------------------------------------------------------------------------
# OPTIONAL — Supabase cloud sync (state is stored locally in the browser by
# default; set these only if you want cross-device sync).
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# NEXT_PUBLIC_CLOUD_STORAGE_ENABLED=true
# Shared secret gating cloud writes; enter the same value once in the UI.
# STATE_SYNC_SECRET=your_long_random_secret

# ----------------------------------------------------------------------------
# OPTIONAL — deploy a read-only preview with sample data and no API keys.
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_DEMO_ONLY=true
